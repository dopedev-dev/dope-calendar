  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/dope-calendar.umd.cjs",
  "module": "./dist/dope-calendar.js",
  "types": "./dist/index.d.ts",
"exports": {
    ".": {
      "types": "./dist/index.d.ts",  
      "import": "./dist/dope-calendar.js",
      "require": "./dist/dope-calendar.umd.cjs"
    },
    "./style.css": "./dist/dope-calendar.css"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "peerDependencies": {
    "vue": "^3.5.22",
    "luxon": "^3.7.2"
  },
  "dependencies": {
    "jalaali-js": "^1.2.8"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.4",
    "@tailwindcss/vite": "^4.1.17",
    "@tsconfig/node22": "^22.0.2",
    "@types/jalaali-js": "^1.2.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-oxlint": "~1.23.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.23.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  },
  "engines": {
    "node": ">=22.x.x <23",
    "npm": "~10.9.2"
  },
  "os": [
    "!win32"
  ],
  "packageManager": "pnpm@10.5.2"
}